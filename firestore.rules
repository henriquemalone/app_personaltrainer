rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo compartilhado de exercícios (vídeo, dicas, músculos) — sem dados pessoais
    match /catalogo/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['nome', 'videos', 'dicas', 'erros', 'principais', 'secundarios', 'subs', 'em'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 200
        && (!('videos' in request.resource.data) || request.resource.data.videos.size() <= 10);
    }
    // Administrador do app (troque pelo e-mail da sua conta no app — o mesmo do ADMIN_EMAIL no config.js)
    function isAdmin() { return request.auth != null && request.auth.token.email == 'henrique.malone@gmail.com'; }
    // Acessos pagos/vitalícios: o usuário só lê o próprio; só o admin grava
    match /acessos/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if isAdmin();
    }
    // Sugestões de melhoria: o usuário logado só cria (com o próprio uid); só o admin lê e apaga
    match /sugestoes/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nome', 'tipo', 'texto', 'versao', 'aparelho', 'em'])
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
        && request.resource.data.aparelho is string && request.resource.data.aparelho.size() <= 300;
      allow read, delete: if isAdmin();
    }
    // Cada usuário só lê e grava os próprios dados (o admin pode ler a lista de usuários)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
